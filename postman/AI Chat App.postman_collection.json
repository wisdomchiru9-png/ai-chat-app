{
  "info": {
    "_postman_id": "aichat-0000-0000-0000-000000000001",
    "name": "AI Chat App (FastAPI + LLM + PostgreSQL)",
    "description": "Full collection covers Health, Sentiment, Chat (with session persistence), and Sessions CRUD endpoints. Import this file into Postman and pair it with the `AI Chat Dev` environment template.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically populate {{session_id}} after POST /sessions:",
          "const s = pm.collectionVariables.get('session_id');",
          "if (!s || s === '') pm.collectionVariables.set('session_id', 'TBD');",
          ""
        ]
      }
    }
  ],
  "variable": [
    { "key": "session_id", "value": "TBD", "type": "string" },
    { "key": "message_id", "value": "TBD", "type": "string" }
  ],
  "item": [
    {
      "name": "0 — Health & Meta",
      "item": [
        {
          "name": "GET / health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status === running', () => pm.response.json().status === 'AI Chat Backend is running');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}", "host": ["{{base_url}}"] }
          }
        }
      ]
    },
    {
      "name": "1 — Sentiment",
      "item": [
        {
          "name": "POST /sentiment — positive",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('label POSITIVE', () => j.label === 'POSITIVE');",
              "pm.test('confidence in (0,1]', () => typeof j.confidence > 0 && j.confidence <= 1);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I absolutely love my new AI chat app! Thank you so much!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/sentiment", "host": ["{{base_url}}"], "path": ["sentiment"] }
          }
        },
        {
          "name": "POST /sentiment — negative",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('label NEGATIVE', () => pm.response.json().label === 'NEGATIVE');"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"My app keeps crashing and I feel terrible about it.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/sentiment", "host": ["{{base_url}}"], "path": ["sentiment"] }
          }
        }
      ]
    },
    {
      "name": "2 — Sessions",
      "item": [
        {
          "name": "POST /sessions — create",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('has session_id', () => !!j.session_id);",
              "pm.collectionVariables.set('session_id', j.session_id);",
              "console.log('session_id set to', j.session_id);"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Resume chat demo\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/sessions", "host": ["{{base_url}}"], "path": ["sessions"] }
          }
        },
        {
          "name": "GET /sessions — list",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('is array', () => Array.isArray(pm.response.json()));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sessions?limit=10",
              "host": ["{{base_url}}"], "path": ["sessions"],
              "query": [{ "key": "limit", "value": "10" }]
            }
          }
        },
        {
          "name": "PATCH /sessions/{id} — rename",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('title updated', () => pm.response.json().title === 'Renamed chat');"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Renamed chat\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/sessions/{{session_id}}", "host": ["{{base_url}}"], "path": ["sessions", "{{session_id}}"] }
          }
        },
        {
          "name": "GET /sessions/{id} — detail",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('has messages array', () => Array.isArray(pm.response.json().messages));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/sessions/{{session_id}}", "host": ["{{base_url}}"], "path": ["sessions", "{{session_id}}"] }
          }
        }
      ]
    },
    {
      "name": "3 — Chat (persisted)",
      "item": [
        {
          "name": "POST /chat turn 1 (persisted)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('has reply', () => !!j.reply && j.reply.length > 0);",
            "pm.test('sentiment populated', () => ['POSITIVE','NEGATIVE'].includes(j.sentiment));",
            "pm.test('session_id echoed', () => j.session_id === pm.collectionVariables.get('session_id'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Give me three tips to make my resume stand out for an AI engineer role.\",\n  \"session_id\": \"{{session_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/chat", "host": ["{{base_url}}"], "path": ["chat"] }
          }
        },
        {
          "name": "POST /chat turn 2 (uses DB history)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Now elaborate on the first tip you just gave me.\",\n  \"session_id\": \"{{session_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/chat", "host": ["{{base_url}}"], "path": ["chat"] }
          }
        },
        {
          "name": "GET /sessions/{id}/messages — confirm persisted",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "pm.test('at least 4 messages (2 turns)', () => pm.response.json().length >= 4);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/sessions/{{session_id}}/messages", "host": ["{{base_url}}"], "path": ["sessions", "{{session_id}}", "messages"] }
          }
        },
        {
          "name": "DELETE /sessions/{id}",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/sessions/{{session_id}}", "host": ["{{base_url}}"], "path": ["sessions", "{{session_id}}"] }
          }
        }
      ]
    },
    {
      "name": "4 — Evaluator (Node.js)",
      "item": [
        {
          "name": "GET evaluator /health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{evaluator_url}}/health", "host": ["{{evaluator_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "POST evaluator /evaluate (2 prompts)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const j = pm.response.json();",
            "pm.test('has ranking', () => Array.isArray(j.ranking) && j.ranking.length > 0);",
            "pm.test('has recommendation', () => !!j.recommendation);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"backends\": [{\"label\": \"local\", \"baseUrl\": \"{{base_url}}\"}],\n  \"prompts\": [\n    {\"prompt\": \"Explain gradient descent to a 10 year old.\", \"expectedSentiment\": \"POSITIVE\"},\n    {\"prompt\": \"My code has a null pointer bug and I am really frustrated with it.\", \"expectedSentiment\": \"NEGATIVE\"}\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{evaluator_url}}/evaluate", "host": ["{{evaluator_url}}"], "path": ["evaluate"] }
          }
        }
      ]
    }
  ]
}
