# ---------------------------------------------------------------------------
# AI Chat Backend — configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you want.
# python-dotenv loads these automatically at startup.
#
# LLM provider choice:
#   provider = openai         -> OpenAI official API (chat completions)
#   provider = openai_compat  -> Any OpenAI-compatible endpoint (Together,
#                                Anyscale, Groq, Ollama with /v1 routes, etc.)
#   provider = hf_inference   -> Hugging Face Inference API (zephyr-7b)
#   provider = local          -> Local transformers (distilgpt2 + distilbert)
#                                Falls back to rule-based if models unavailable.
# ---------------------------------------------------------------------------

LLM_PROVIDER=local

# --- OpenAI (native) -------------------------------------------------------
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Default model — gpt-4o-mini is cheap and capable for chat
OPENAI_MODEL=gpt-4o-mini

# --- OpenAI-compatible endpoint (Together / Groq / Anyscale / Ollama) ------
# Example values:
#   Together : https://api.together.xyz/v1
#   Groq     : https://api.groq.com/openai/v1
#   Ollama   : http://localhost:11434/v1   (run `ollama serve` + `ollama pull llama3`)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- Hugging Face Inference API -------------------------------------------
# Get one from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# --- LLM knobs ------------------------------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=300
LLM_SYSTEM_PROMPT=You are a friendly, concise AI assistant. If the user's message suggests a strong emotion, acknowledge it naturally.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# By default the app uses a local SQLite file (zero setup).
# To use PostgreSQL (or any SQLAlchemy-supported DB), set the full URL:
#
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_chat_app
#
# (requires Postgres to be running and the user + database to exist)
DATABASE_URL=
